{
  "name": "@paid/web",
  "version": "0.0.0",
  "private": true,
  "description": "Interfaz React de la PAID",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:demo": "tsc --noEmit -p tsconfig.json && vite build --mode demo && node ../../scripts/empaquetar-demo.mjs --fragmento"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@paid/schema": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "maplibre-gl": "4.7.1",
    "pmtiles": "4.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.88.0",
    "react-router-dom": "6.30.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  }
}
