# Reproducibilidad en red cerrada: sin rangos abiertos y sin resolver a «latest».
save-exact=true
save-prefix=
# El lockfile se versiona y manda: una instalacion no puede modificarlo en CI.
# (En desarrollo local usar `pnpm install` normal; en CI, `--frozen-lockfile`.)
strict-peer-dependencies=false
# Registro espejado de la Intranet ARC: descomentar y apuntar al espejo.
# registry=http://registro-npm.intranet.arc/
