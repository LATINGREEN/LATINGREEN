# ─────────────────────────────────────────────────────────────────────────────
# PAID — variables de entorno de ejemplo.  Copiar a `.env` y ajustar.
# NUNCA versionar `.env`.
#
# OJO (R2): los rangos de red autorizados NO viven aqui. Viven en la tabla
# `seg.red_autorizada` (tipo CIDR) para que JACID pueda cambiarlos sin
# desplegar. Si ves una variable de entorno con CIDR, es un error.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
TZ=UTC

# ── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=paid
POSTGRES_USER=paid_app
POSTGRES_PASSWORD=cambiar_en_despliegue
# Superusuario solo para migraciones y creacion de extensiones.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=cambiar_en_despliegue
DATABASE_URL=postgres://paid_app:cambiar_en_despliegue@localhost:5432/paid
DATABASE_URL_ADMIN=postgres://postgres:cambiar_en_despliegue@localhost:5432/paid

# El pool NUNCA debe reutilizar el contexto de sesion entre peticiones (R7/P11).
# El contexto se fija con SET LOCAL dentro de la transaccion.
DATABASE_POOL_MAX=10

# ── Redis (sesiones, TTL deslizante de 10 min — R1) ──────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SESION_TTL_SEGUNDOS=600
SESION_AVISO_SEGUNDOS=480

# ── MinIO (adjuntos) ─────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=paid_minio
MINIO_SECRET_KEY=cambiar_en_despliegue
MINIO_BUCKET=paid-adjuntos
# Cuota AGREGADA por actividad, en bytes (R11). 10 MB = 10485760.
ADJUNTO_CUOTA_BYTES_POR_ACTIVIDAD=10485760

# ── Observabilidad (colector local; sin telemetria saliente — A.2.1) ─────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=paid-api
LOG_LEVEL=info

# ── API / Web ────────────────────────────────────────────────────────────────
API_PUERTO=3000
API_PREFIJO=/api
WEB_PUERTO=5173
VITE_API_URL=http://localhost:3000/api

# ── Subsistema de IA (Parte B). Apagarlo NO debe degradar nada (IA6). ────────
IA_HABILITADA=false
IA_URL=http://localhost:8000
IA_TIMEOUT_MS=2000

# ── Semillas de desarrollo ───────────────────────────────────────────────────
# PAID_SEMILLA_DESARROLLO=1 siembra unidades, credenciales de prueba y un rango
# de red 0.0.0.0/0. R2 pide ese rango para desarrollo, pero es lo peor que puede
# llegar a produccion: con NODE_ENV=production la API se NIEGA a arrancar si lo
# encuentra. Dejalo sin definir salvo en tu maquina.
# PAID_SEMILLA_DESARROLLO=1

# Usuario de la aplicacion: debe ser NOSUPERUSER NOBYPASSRLS.
# Un superusuario ignora las politicas RLS y anula el aislamiento por unidad
# (R6) sin que nada falle.
