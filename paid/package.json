{
  "name": "paid",
  "version": "0.0.0",
  "private": true,
  "description": "PAID — Plataforma de Accion Integral y Desarrollo, Armada de Colombia",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test && node scripts/autoauditoria.mjs --comprobar",
    "auditoria": "node scripts/autoauditoria.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @paid/db generate",
    "db:migrate": "pnpm --filter @paid/db migrate",
    "db:seed": "pnpm --filter @paid/db seed",
    "eval:ia": "echo 'TODO(Fase 7): conjunto de referencia de B.7. Sin implementar todavia.' && exit 1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
